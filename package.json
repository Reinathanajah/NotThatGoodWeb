{
  "name": "notthatgoodweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/src/db/seed.ts",
    "test:wave1": "tsx server/src/tests/wave1.smoke.ts",
    "test:wave2": "tsx server/src/tests/wave2.smoke.ts",
    "test:wave3": "tsx server/src/tests/wave3.smoke.ts",
    "test:wave4": "tsx server/src/tests/wave4.smoke.ts",
    "test:wave5": "tsx server/src/tests/wave5.smoke.ts",
    "test:wave6": "tsx server/src/tests/wave6.smoke.ts",
    "test:wave7": "tsx server/src/tests/wave7.smoke.ts",
    "test:wave8": "tsx server/src/tests/wave8.smoke.ts",
    "test:wave9": "tsx server/src/tests/wave9.smoke.ts",
    "test:wave10": "tsx server/src/tests/wave10.smoke.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.73.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
