# Client-side Vite environment variables (must start with VITE_)
VITE_APP_NAME=SilverFour
VITE_APP_ENV=development
VITE_API_URL=http://localhost:3001/api/v1
VITE_PORT=5173

# Backend REST API configuration
BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-random-64-char-hex-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# File upload and private storage limits (100 MB assignment file, 2 GB private quota)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=104857600
PRIVATE_FILES_QUOTA_BYTES=2147483648
COMPILATIO_ENABLED=false

# Server-only Neon Postgres connection strings (never prefix with VITE_)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_API_KEY=your-neon-api-key
NEON_PROJECT_ID=your-neon-project-id
NEON_ORG_ID=your-neon-org-id
